TV_IP=192.168.1.100
TV_MAC=aa:bb:cc:dd:ee:ff
TARGET_INPUT=HDMI_1

# Shared lock used to avoid overlapping wake/switch runs from multiple services.
ACTION_LOCK_FILE=/tmp/lg-tv-control.lock

# Steam button listener settings.
# This uses the Linux input stack's documented BTN_MODE event from the
# controller's /dev/input/event* device instead of reverse-engineering hidraw.
# Prefer BUTTON_DEVICE_ID so the service can resolve the current event node
# automatically. Accepts either BUS:VENDOR:PRODUCT or VENDOR:PRODUCT.
# Example Valve IDs look like 0003:28de:1142 or 28de:1142.
BUTTON_DEVICE_ID=28de:1142

# Optional explicit override if you want to pin a specific event node.
# BUTTON_EVENT_DEVICE=/dev/input/event0

# Optional explicit override for the input event code to watch.
# Defaults to BTN_MODE, which is the Steam button according to hid-steam.c.
# BUTTON_EVENT_CODE=BTN_MODE

# Minimum seconds between accepted presses.
BUTTON_DEBOUNCE_SECONDS=3

# Optional listener tracing.
# BUTTON_TRACE_MATCHES=true
# BUTTON_TRACE_LIMIT=200
