TV_IP=192.168.1.100
TV_MAC=aa:bb:cc:dd:ee:ff
TARGET_INPUT=HDMI_1

# Shared lock used to avoid overlapping wake/switch runs from multiple services.
ACTION_LOCK_FILE=/tmp/lg-tv-control.lock

# Steam button listener settings.
# This uses the Valve raw HID controller interface and the 2026 controller
# report layout from the decktation `steam-controller-2026` branch.
# Prefer BUTTON_DEVICE_ID so the service can resolve the correct hidraw node
# automatically. Accepts either BUS:VENDOR:PRODUCT or VENDOR:PRODUCT.
# Example Valve IDs look like 0003:28de:1304 or 28de:1304.
BUTTON_DEVICE_ID=28de:1142

# Optional explicit override if you want to pin a specific hidraw node.
# BUTTON_DEVICE=/dev/hidraw0

# Button to monitor from the raw Valve report stream.
# The 2026 controller mappings come from decktation's raw parser.
# `STEAM` uses the additional byte matcher below because the SteamOS button is
# not present in that branch's published button bit table.
BUTTON_NAME=STEAM

# Size of a single HID read. Keep this at 64 so both legacy 64-byte reports and
# 2026 54-byte reports on the same interface are handled correctly.
BUTTON_REPORT_SIZE=64

# Steam button byte matcher on the 2026 controller stream.
# These defaults reflect the current empirical offsets from this repo's traces,
# but the device-selection and report framing now come from decktation's parser.
BUTTON_MATCH_HEX=74
BUTTON_MATCH_MASK_HEX=fe
BUTTON_MATCH_OFFSET=33

# Minimum seconds between accepted presses.
BUTTON_DEBOUNCE_SECONDS=3

# Optional listener tracing.
# BUTTON_TRACE_MATCHES=true
# BUTTON_TRACE_LIMIT=200
