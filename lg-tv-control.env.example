TV_IP=192.168.1.100
TV_MAC=aa:bb:cc:dd:ee:ff
TARGET_INPUT=HDMI_1

# Shared lock used to avoid overlapping wake/switch runs from multiple services.
ACTION_LOCK_FILE=/tmp/lg-tv-control.lock

# Steam button listener settings.
# Prefer BUTTON_DEVICE_ID so the service can resolve the current hidraw node
# automatically. Accepts either BUS:VENDOR:PRODUCT or VENDOR:PRODUCT.
# Example Valve IDs look like 0003:28de:1142 or 28de:1142.
BUTTON_DEVICE_ID=28de:1142

# Optional explicit override if you want to pin a specific hidraw node.
# BUTTON_DEVICE=/dev/hidraw0

# Size of a single HID report in bytes. The example captures in this repo use 54.
BUTTON_REPORT_SIZE=54

# Hex bytes to match for the Steam button press report.
# Whitespace is ignored.
BUTTON_MATCH_HEX=0000010000000000

# Optional bit mask applied when matching BUTTON_MATCH_HEX.
# Use ff for bytes that must match and 00 for bytes that should be ignored.
BUTTON_MATCH_MASK_HEX=

# Byte offset into the HID report where BUTTON_MATCH_HEX begins.
BUTTON_MATCH_OFFSET=2

# Minimum seconds between accepted presses.
BUTTON_DEBOUNCE_SECONDS=3
